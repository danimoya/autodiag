# Copy to testbed/.env (git-ignored) and change the passwords.
ORACLE_PWD=ChangeMe_Sys_1
AUTODIAG_USER_PWD=AutoDiag_Ro_1
AUTODIAG_TEST_PWD=AutoDiag_Test_1
# Public key installed for the oracle user inside the container
AUTODIAG_SSH_PUBKEY=~/.ssh/id_ed25519.pub
# Optional: alternative base image (e.g. gvenzl/oracle-free:23-full)
#AUTODIAG_ORACLE_BASE_IMAGE=container-registry.oracle.com/database/free:23.26.3.0
# The fault kit needs ORADEBUG (disabled by default in Oracle Database Free); set false to keep it off
AUTODIAG_ENABLE_ORADEBUG=true
