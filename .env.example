AUTODIAG_CONFIG=~/.config/autodiag/config.toml
AUTODIAG_LISTEN_HOST=127.0.0.1
AUTODIAG_LISTEN_PORT=8790
AUTODIAG_OLLAMA_PRIMARY_URL=http://ollama.example.internal:11434
AUTODIAG_OLLAMA_ADVISOR_MODEL=qwen3:27b
AUTODIAG_MCP_TOKEN=change-me
